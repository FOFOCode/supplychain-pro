# Variables comunes de la app (ejemplo)
DB_HOST=supplychainpro-db
DB_PORT=3306
DB_NAME=supplychain_db
DB_USER=supplychain_user
DB_PASSWORD=admin
DB_ROOT_PASSWORD=admin
PORT=5000
BACKEND_HOST_PORT=5001
PHPMYADMIN_HOST_PORT=8080
NODE_ENV=production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=cambia_esta_secret_por_uno_seguro_minimo_32_caracteres
BACKEND_URL=http://supplychainpro-backend:5000
SIM_STATE_PATH=/data/journeys.json

# ── Monitoring tools ─────────────────────────────────────────────────────────
# Pingdom: token de tu cuenta en https://my.pingdom.com → Integrations → API keys
PINGDOM_API_TOKEN=your_pingdom_api_token_here
# Munin node: nombre del servicio Docker y puerto por defecto (4949)
MUNIN_NODE_HOST=monitoring-munin-node
MUNIN_NODE_PORT=4949
# Fail2ban: ruta del log montada desde el contenedor fail2ban
FAIL2BAN_LOG_PATH=/var/log/fail2ban/fail2ban.log
